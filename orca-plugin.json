{
  "manifestVersion": 2,
  "id": "avari-glow-tweaks",
  "name": "Avari Glow Tweaks",
  "version": "0.1.2",
  "description": "Optional macOS interface tweaks for Avari Glow. Builds a local tool with Go and modifies Orca.app after an explicit action.",
  "repository": "https://github.com/OstKost/avari-glow-orca-tweaks",
  "homepage": "https://github.com/OstKost/orca-avari-glow-theme",
  "license": "LicenseRef-Avari",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.mjs",
  "contributes": {
    "panels": [
      {
        "id": "avari-tweaks",
        "title": "Avari Glow Tweaks",
        "icon": "settings",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "cover": {
    "path": "images/cover.png",
    "alt": "Illustrated preview of Avari Glow Tweaks with styled tabs, sidebars, workspace highlight and composer"
  }
}
